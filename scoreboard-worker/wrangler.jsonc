{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jt-scoreboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jt-scoreboard",
      "database_id": "65369763-c48f-4aaf-a61b-feaad5effc80"
    }
  ],
  "ratelimits": [
    {
      "name": "RUN_RATE_LIMITER",
      "namespace_id": "824001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SCORE_RATE_LIMITER",
      "namespace_id": "824002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
